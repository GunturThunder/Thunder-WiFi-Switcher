<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the macOS app. Tauri signs it with the hardened runtime
  (needed for notarization), and under the hardened runtime macOS silently
  skips the Location prompt unless the app declares it uses Location.
  The app only needs Location so macOS will show Wi-Fi network names; it
  never reads a location (see PRIVACY.md).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.personal-information.location</key>
    <true/>
</dict>
</plist>
